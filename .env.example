# 复制本文件为 .env 并填写实际值
# 数据库连接（同步驱动 psycopg2；库名含连字符）
DATABASE_URL=postgresql+psycopg2://postgres:123456@127.0.0.1:5432/sports-health-platform
# 会话签名密钥（生产环境务必改为随机长串）
SECRET_KEY=change-me-to-a-random-secret
# 服务端口（避开 8000）
PORT=8010
# 开发环境 False；HTTPS 环境下设为 True
SESSION_COOKIE_SECURE=False

# 角色（2026-11-19）：/system 与 /api/system 仅管理员可访问。
# 留空时由库里 id 最小的启用账号担任管理员；需要指定时填逗号分隔的登录名。
ADMIN_USERNAMES=

# V2 AI: OpenAI-compatible endpoint; keep the real key only in .env
AI_API_KEY=
AI_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
AI_DEFAULT_MODEL=deepseek-v4.1-flash
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
# AI 导入（2026-11-10）：纯文字 / 带图分别选模型；图片与文字上限由后端兜底
AI_IMPORT_MODEL=qwen3.8-flash
AI_IMPORT_VISION_MODEL=qwen3-vl-plus
AI_IMPORT_TIMEOUT_SECONDS=60
AI_IMPORT_MAX_IMAGES=3
AI_IMPORT_MAX_IMAGE_BYTES=2097152
AI_IMPORT_MAX_PROMPT_CHARS=2000

# AI 运动报告（周报/月报）：REPORT_MODEL 留空跟随 AI_DEFAULT_MODEL；自动生成由应用内调度器触发
REPORT_AUTO_ENABLED=True
REPORT_MODEL=
REPORT_TIMEOUT_SECONDS=60
REPORT_MAX_ATTEMPTS=3
# 报告为非流式结构化输出，开启思考容易触发读超时；默认关闭，仅对 qwen* 模型生效
REPORT_ENABLE_THINKING=False

# AI Agent（V2.2 基础问答）：复用上方 DATABASE_URL 与 AI 密钥；checkpointer 用 psycopg3 连接
AGENT_STREAM_ENABLED=True
AGENT_CONTEXT_TOKEN_BUDGET=12000
AGENT_CHECKPOINTER_SCHEMA=langgraph
AGENT_MAX_INPUT_CHARS=2000
AGENT_POOL_MIN_SIZE=1
AGENT_POOL_MAX_SIZE=10

# 应用内定时任务（2026-11-17）：周报周一 08:00、月报每月 1 日 08:00；错过不补，页面手动执行
SCHEDULER_ENABLED=True
SCHEDULER_TIMEZONE=Asia/Shanghai
SCHEDULER_MISFIRE_GRACE_SECONDS=300

# 侧栏每日训练建议（V2.8，2026-11-17）：00:01 生成当天一份；启动后按秒数补跑缺失行，0 关闭补跑
# 模型固定跟随 AI_DEFAULT_MODEL，没有独立模型键（技能参数解析同理）
ADVICE_AUTO_ENABLED=True
ADVICE_TIMEOUT_SECONDS=30
ADVICE_MAX_ATTEMPTS=3
ADVICE_STARTUP_CATCHUP_SECONDS=60

# 联网搜索（V2.13，2026-11-24）：Tavily 检索；默认关闭，只在会话输入框打开「联网」的那一轮生效
WEB_SEARCH_ENABLED=True
TAVILY_API_KEY=
TAVILY_SEARCH_URL=https://api.tavily.com/search
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_SNIPPET_CHARS=1200
