# 复制本文件为 .env 并填写实际值
# 数据库连接（同步驱动 psycopg2；库名含连字符）
DATABASE_URL=postgresql+psycopg2://postgres:123456@127.0.0.1:5432/sports-health-platform
# 会话签名密钥（生产环境务必改为随机长串）
SECRET_KEY=change-me-to-a-random-secret
# 服务端口（避开 8000）
PORT=8010
# 开发环境 False；HTTPS 环境下设为 True
SESSION_COOKIE_SECURE=False

# V2 AI: OpenAI-compatible endpoint; keep the real key only in .env
AI_API_KEY=
AI_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
AI_DEFAULT_MODEL=deepseek-v4.1-flash
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
# AI 导入（2026-11-10）：纯文字 / 带图分别选模型；图片与文字上限由后端兜底
AI_IMPORT_MODEL=qwen3.8-flash
AI_IMPORT_VISION_MODEL=qwen3-vl-plus
AI_IMPORT_TIMEOUT_SECONDS=60
AI_IMPORT_MAX_IMAGES=3
AI_IMPORT_MAX_IMAGE_BYTES=2097152
AI_IMPORT_MAX_PROMPT_CHARS=2000
